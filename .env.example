# Server runtime configuration
PORT="3000"
NODE_ENV="development"

# Canonical public domain for sitemap.xml, robots.txt, Open Graph, and canonical URLs
PUBLIC_SITE_URL="https://resumiq.ai"

# Optional Google Search Console HTML verification token
GOOGLE_SITE_VERIFICATION=""

# Optional server-side writing assistant configuration
# Note: Resume Builder, PDF/DOCX export, and the 100-point ATS Checker work without this key.
# GEMINI_API_KEY="YOUR_GEMINI_API_KEY"
# GEMINI_PRIMARY_MODEL="gemini-3.8-flash"
# AI_REQUEST_TIMEOUT_MS="28000"

# Optional PostgreSQL database configuration (Drizzle ORM) for user accounts & saved history
# SQL_HOST="YOUR_POSTGRES_HOST"
# SQL_DB_NAME="YOUR_POSTGRES_DATABASE"
# SQL_USER="YOUR_POSTGRES_APP_USER"
# SQL_PASSWORD="YOUR_POSTGRES_APP_PASSWORD"

# Optional PostgreSQL admin credentials (used only when running drizzle-kit schema migrations)
# SQL_ADMIN_USER="YOUR_POSTGRES_ADMIN_USER"
# SQL_ADMIN_PASSWORD="YOUR_POSTGRES_ADMIN_PASSWORD"


